{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/vendor/:path*",
      "destination": "/vendor-portal.html"
    },
    {
      "source": "/vendor",
      "destination": "/vendor-portal.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/schedules",
      "destination": "/schedules.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(.*admin.*)"
        }
      ],
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
