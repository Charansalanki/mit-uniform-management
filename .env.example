# =================================================================
# MIT UNIFORM MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env

# --- BACKEND SERVER CONFIGURATION ---
PORT=4000
NODE_ENV=production
DATABASE_PATH=server/data/mit_uniform.db
UPLOAD_STORAGE=server/uploads

# --- SECURITY & AUTHENTICATION ---
# Generate a secure 64-character random key: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_64_char_hex_key_here

# Initial password for default SUPER_ADMIN (admin@mitmysore.in / MITM)
ADMIN_INITIAL_PASSWORD=ChangeMeOnFirstLogin2026!

# --- CROSS-ORIGIN RESOURCE SHARING (CORS) ---
# Comma-separated list of allowed frontend domains in production:
CORS_ORIGINS=https://uniforms.mitmysore.in,https://admin.mitmysore.in

# --- FRONTEND ENVIRONMENT CONFIGURATION (Vite) ---
# Set this in your Vercel/Netlify frontend environment:
VITE_API_URL=https://api.uniforms.mitmysore.in
