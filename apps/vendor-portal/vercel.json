{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.uniforms.mitmysore.in/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api.uniforms.mitmysore.in/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
